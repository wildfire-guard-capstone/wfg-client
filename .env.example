# Unset VITE_API_MODE to run main's original demo without API calls.
# Copy to .env.local and restart Vite to connect the existing UI to EC2.
VITE_API_MODE=http
VITE_API_BASE_URL=/api/v1

# Vite forwards /api/v1 to EC2. This is a server-only variable, never VITE_*.
API_PROXY_TARGET=http://54.116.227.3
# For isolated tests, use VITE_API_MODE=mock (synthetic data, no EC2 calls).

# Only after the backend provides the issuance jurisdiction ID:
# VITE_ACCOUNT_ADMIN_AREA_ID=
# Never put passwords, access tokens or SSH keys in VITE_* variables.
