# Unset VITE_API_MODE to run main's original demo without API calls.
# Copy to .env.local and restart Vite to connect the EXISTING UI to API-shaped mocks.
VITE_API_MODE=mock
VITE_API_BASE_URL=/api/v1

# For the actual backend, set VITE_API_MODE=http and point this to a READY server/tunnel.
# API_PROXY_TARGET=http://127.0.0.1:8000

# Only after the backend provides the issuance jurisdiction ID:
# VITE_ACCOUNT_ADMIN_AREA_ID=
# Never put passwords, access tokens or SSH keys in VITE_* variables.
