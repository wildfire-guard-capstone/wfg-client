# These settings are read when createApiClientFromEnv(import.meta.env) is used.
# Existing main UI remains on its original demo runtime in this PR.
# Setting these variables alone does not switch the displayed screen to API data.
VITE_API_MODE=mock
VITE_API_BASE_URL=/api/v1

# Optional development-only proxy. Enable AFTER a local backend/tunnel is available.
# API_PROXY_TARGET=http://127.0.0.1:8000
# Do not put passwords, access tokens, or SSH keys in VITE_* variables.
